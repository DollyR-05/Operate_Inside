<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo.CalculatorController"
            prefWidth="300" prefHeight="400">

    <center>
        <VBox spacing="10" alignment="CENTER" style="-fx-background-color: #202020;">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <TextField fx:id="display" editable="false" style="-fx-font-size: 18;"/>

            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Button text="7" onAction="#onNumber" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Button text="8" onAction="#onNumber" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Button text="9" onAction="#onNumber" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Button text="+" onAction="#onOperator" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Button text="4" onAction="#onNumber" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Button text="5" onAction="#onNumber" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Button text="6" onAction="#onNumber" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Button text="-" onAction="#onOperator" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Button text="1" onAction="#onNumber" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Button text="2" onAction="#onNumber" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Button text="3" onAction="#onNumber" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <Button text="*" onAction="#onOperator" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <Button text="0" onAction="#onNumber" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Button text="C" onAction="#onClear" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Button text="=" onAction="#onEvaluate" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                <Button text="/" onAction="#onOperator" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
            </GridPane>
        </VBox>
    </center>
</BorderPane>
